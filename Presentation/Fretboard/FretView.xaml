<UserControl x:Class="Presentation.Fretboard.FretView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Presentation.Fretboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:FretViewModel}">
  <!-- The border marks the notes of the scale that is shown: blue for the notes, orange for the root. -->
  <Border BorderThickness="3">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsInScale.Value}" Value="True">
            <Setter Property="BorderBrush" Value="SteelBlue"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsScaleRoot.Value}" Value="True">
            <Setter Property="BorderBrush" Value="DarkOrange"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <!-- The inner border marks the notes of the chord in the Find chord box: green, and red for the root. -->
    <Border BorderThickness="2">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChordTone.Value}" Value="True">
              <Setter Property="BorderBrush" Value="SeaGreen"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsChordRoot.Value}" Value="True">
              <Setter Property="BorderBrush" Value="Crimson"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <ToggleButton IsChecked="{Binding IsChecked.Value, Mode=TwoWay}">
        <StackPanel>
          <TextBlock Text="{Binding Caption.Value}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding ChordToneLabel.Value}"
                     HorizontalAlignment="Center"
                     FontSize="10"
                     FontWeight="Bold"/>
        </StackPanel>
      </ToggleButton>
    </Border>
  </Border>
</UserControl>
